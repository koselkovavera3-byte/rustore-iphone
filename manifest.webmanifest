import SwiftUI

// MARK: - Model

struct StoreApp: Identifiable {
    let id: Int
    let name: String
    let developer: String
    let category: String
    let rating: Double
    let description: String
    let icon: String
    let officialURL: URL?
}

// MARK: - Catalog

let storeApps: [StoreApp] = [

    StoreApp(
        id: 1,
        name: "ВКонтакте",
        developer: "VK",
        category: "Социальные",
        rating: 4.6,
        description: "Общение, музыка, видео и сообщества.",
        icon: "message.fill",
        officialURL: URL(string: "https://vk.com/")
    ),

    StoreApp(
        id: 2,
        name: "Госуслуги",
        developer: "Минцифры России",
        category: "Государство",
        rating: 4.8,
        description: "Государственные услуги в одном приложении.",
        icon: "building.columns.fill",
        officialURL: URL(string: "https://www.gosuslugi.ru/")
    ),

    StoreApp(
        id: 3,
        name: "СберБанк",
        developer: "Сбер",
        category: "Финансы",
        rating: 4.9,
        description: "Банковские сервисы и платежи.",
        icon: "creditcard.fill",
        officialURL: URL(string: "https://www.sberbank.ru/")
    ),

    StoreApp(
        id: 4,
        name: "RuStore",
        developer: "RuStore",
        category: "Магазины",
        rating: 4.7,
        description: "Каталог приложений для российских пользователей.",
        icon: "square.grid.2x2.fill",
        officialURL: URL(string: "https://www.rustore.ru/")
    )
]

// MARK: - Main View

struct ContentView: View {

    @State private var searchText = ""
    @State private var selectedTab = 0

    private var filteredApps: [StoreApp] {

        if searchText
            .trimmingCharacters(in: .whitespacesAndNewlines)
            .isEmpty {

            return storeApps
        }

        let query = searchText.lowercased()

        return storeApps.filter { item in

            item.name.lowercased().contains(query) ||
            item.developer.lowercased().contains(query) ||
            item.category.lowercased().contains(query) ||
            item.description.lowercased().contains(query)
        }
    }

    var body: some View {

        TabView(selection: $selectedTab) {

            NavigationStack {

                List {

                    Section {

                        ForEach(filteredApps) { item in

                            NavigationLink {
                                AppDetailView(item: item)
                            } label: {

                                AppRow(item: item)
                            }
                        }

                    } header: {

                        Text("Каталог приложений")
                    }
                }
                .listStyle(.insetGrouped)
                .navigationTitle("RuStore")
                .searchable(
                    text: $searchText,
                    placement: .navigationBarDrawer(
                        displayMode: .always
                    ),
                    prompt: "Поиск приложений"
                )
            }
            .tabItem {
                Label("Главная", systemImage: "house.fill")
            }
            .tag(0)

            FavoritesView()
                .tabItem {
                    Label(
                        "Избранное",
                        systemImage: "heart.fill"
                    )
                }
                .tag(1)

            ProfileView()
                .tabItem {
                    Label(
                        "Профиль",
                        systemImage: "person.fill"
                    )
                }
                .tag(2)
        }
    }
}

// MARK: - App Row

struct AppRow: View {

    let item: StoreApp

    var body: some View {

        HStack(spacing: 14) {

            Image(systemName: item.icon)
                .font(.system(size: 25))
                .foregroundStyle(.white)
                .frame(
                    width: 58,
                    height: 58
                )
                .background(
                    RoundedRectangle(
                        cornerRadius: 15
                    )
                    .fill(.black)
                )

            VStack(
                alignment: .leading,
                spacing: 4
            ) {

                Text(item.name)
                    .font(.headline)

                Text(item.developer)
                    .font(.subheadline)
                    .foregroundStyle(.secondary)

                HStack(spacing: 5) {

                    Image(systemName: "star.fill")
                        .font(.caption2)

                    Text(
                        "\(item.rating, specifier: "%.1f")"
                    )
                    .font(.caption)

                    Text("•")
                        .foregroundStyle(.secondary)

                    Text(item.category)
                        .font(.caption)
                        .foregroundStyle(.secondary)
                }
            }

            Spacer()
        }
        .padding(.vertical, 5)
    }
}

// MARK: - Detail

struct AppDetailView: View {

    let item: StoreApp

    @Environment(\.openURL)
    private var openURL

    var body: some View {

        ScrollView {

            VStack(
                alignment: .leading,
                spacing: 22
            ) {

                HStack(spacing: 16) {

                    Image(systemName: item.icon)
                        .font(.system(size: 38))
                        .foregroundStyle(.white)
                        .frame(
                            width: 88,
                            height: 88
                        )
                        .background(
                            RoundedRectangle(
                                cornerRadius: 22
                            )
                            .fill(.black)
                        )

                    VStack(
                        alignment: .leading,
                        spacing: 5
                    ) {

                        Text(item.name)
                            .font(.title2)
                            .bold()

                        Text(item.developer)
                            .foregroundStyle(.secondary)

                        Label(
                            "\(item.rating, specifier: "%.1f")",
                            systemImage: "star.fill"
                        )
                        .font(.subheadline)
                    }

                    Spacer()
                }

                Text(item.description)
                    .font(.body)

                VStack(
                    alignment: .leading,
                    spacing: 8
                ) {

                    Text("Категория")
                        .font(.headline)

                    Text(item.category)
                        .foregroundStyle(.secondary)
                }

                Divider()

                Text("Установка")
                    .font(.title3)
                    .bold()

                Text(
                    "Установка выполняется через официальный "
                    + "канал распространения приложения. "
                    + "RuStore не запрашивает Apple ID или пароль."
                )
                .foregroundStyle(.secondary)

                if let url = item.officialURL {

                    Button {

                        openURL(url)

                    } label: {

                        Label(
                            "Открыть официальный источник",
                            systemImage: "arrow.up.right"
                        )
                        .frame(maxWidth: .infinity)
                        .frame(height: 52)
                    }
                    .buttonStyle(.borderedProminent)
                }
            }
            .padding()
        }
        .navigationTitle(item.name)
        .navigationBarTitleDisplayMode(.inline)
    }
}

// MARK: - Favorites

struct FavoritesView: View {

    var body: some View {

        NavigationStack {

            VStack(spacing: 16) {

                Image(systemName: "heart")
                    .font(.system(size: 50))
                    .foregroundStyle(.secondary)

                Text("Избранное")
                    .font(.title2)
                    .bold()

                Text(
                    "Здесь будут приложения, "
                    + "которые ты добавишь в избранное."
                )
                .multilineTextAlignment(.center)
                .foregroundStyle(.secondary)
                .padding(.horizontal)
            }
            .navigationTitle("Избранное")
        }
    }
}

// MARK: - Profile

struct ProfileView: View {

    var body: some View {

        NavigationStack {

            List {

                Section {

                    HStack(spacing: 14) {

                        Image(
                            systemName: "person.fill"
                        )
                        .font(.title2)
                        .foregroundStyle(.white)
                        .frame(
                            width: 58,
                            height: 58
                        )
                        .background(
                            Circle()
                                .fill(.black)
                        )

                        VStack(
                            alignment: .leading
                        ) {

                            Text("Пользователь")
                                .font(.headline)

                            Text("RuStore")
                                .font(.subheadline)
                                .foregroundStyle(
                                    .secondary
                                )
                        }
                    }
                    .padding(.vertical, 5)
                }

                Section("О приложении") {

                    LabeledContent(
                        "Версия",
                        value: "1.0.0"
                    )

                    LabeledContent(
                        "Платформа",
                        value: "iOS"
                    )
                }
            }
            .navigationTitle("Профиль")
        }
    }
}

